# ==============================================================================
# CodeArcade Environment Configuration
# ==============================================================================
# NOTE: All keys defined in this file are STRICTLY server-side only.
# Under NO circumstances should any external AI API key be exposed to the client bundle
# or prefixed with VITE_. The Node.js/Express server acts as a secure proxy layer.
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV=development

# AI Service Provider Configuration
# Choose your preferred provider. CodeArcade supports Google Gemini and OpenAI natively.
# If no external key is provided, the platform automatically engages its built-in
# Intelligent Pedagogical Engine so all features work seamlessly out of the box.

# Google Gemini API Key (Recommended for fast pedagogical inference)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Alternatively: OpenAI API Key
# Obtain from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Preferred AI Model (e.g. gemini-2.5-flash, gemini-1.5-pro, gpt-4o-mini)
AI_MODEL=gemini-2.5-flash

# Security & Anti-Abuse Rate Limiting
# Maximum API requests permitted per window per IP
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Max tokens for tutor responses to ensure concise, focused micro-guidance
MAX_RESPONSE_TOKENS=1000
